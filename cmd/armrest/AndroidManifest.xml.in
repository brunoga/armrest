<?xml version="1.0" encoding="utf-8"?>
<!--
	Fyne's AndroidManifest.xml, with Bluetooth: Armrest updates the
	remote's firmware over it (internal/androidble). make android renders
	this into AndroidManifest.xml, with the version of FyneApp.toml.
-->
<manifest
	xmlns:android="http://schemas.android.com/apk/res/android"
	package="io.github.brunoga.armrest"
	android:versionCode="@BUILD@"
	android:versionName="@VERSION@">

	<application android:label="Armrest" android:debuggable="true">
	<activity android:name="org.golang.app.GoNativeActivity"
		android:label="Armrest"
		android:configChanges="orientation|keyboardHidden|uiMode"
		android:exported="true"
		android:theme="@android:style/Theme">
		<meta-data android:name="android.app.lib_name" android:value="Armrest" />
		<intent-filter>
			<action android:name="android.intent.action.MAIN" />
			<category android:name="android.intent.category.LAUNCHER" />
		</intent-filter>
	</activity>

	<receiver android:name="org.golang.app.FyneNotificationReceiver"
			  android:exported="false" />
	</application>

	<uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
	<uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
	<uses-permission android:name="android.permission.INTERNET" />
	<!-- Connecting to the remote by its address: no scanning, no location.
	     The app targets API 29 (Fyne's), so Android grants BLUETOOTH at
	     install, on Android 12 too; BLUETOOTH_CONNECT is for a later target. -->
	<uses-permission android:name="android.permission.BLUETOOTH" />
	<uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
	<uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
</manifest>
